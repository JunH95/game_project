[ext_resource type="Script" path="res://scripts/resources/synergy_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"janggun_gangrim"
display_name = "장군 강림"
god_a = &"jakdodaesin"
god_b = &"choeyeong"
effect = &"jakdu_taegi"
description = "작두의 신과 장군신이 함께 실린다. 기세가 차오르면 장군신이 내려 작두를 탄다 — 잠시 사방을 벤다."
