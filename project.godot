[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hurtbox"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="player_hitbox"
2d_physics/layer_7="enemy_hitbox"
2d_physics/layer_8="pickup"
2d_physics/layer_9="pickup_magnet"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
environment/defaults/default_clear_color=Color(0.039216, 0.039216, 0.070588, 1)
